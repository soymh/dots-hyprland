# LFM3 Quickshell assistant bridge configuration.
# Copy to ~/.config/lfm3-assistant/config.env and edit.
# Environment variables with the same names override this file.

# --- Model discovery (router mode) -----------------------------------------
# The bridge scans this Hugging Face cache for snapshots/*/*.gguf, groups
# mmproj files, and writes a router preset file. One model loads at a time.

# Hugging Face cache root (contains models--* directories).
MODELS_CACHE=$HOME/.models/hub

# Generated router presets. Rewritten on startup and on models_refresh.
MODELS_PRESET=$HOME/.config/lfm3-assistant/models.ini

# Maximum number of models loaded at once (4 GB GPU: keep this at 1).
MODELS_MAX=1

# MiB of device memory the router keeps free when loading a model.
MODELS_MEMORY_MARGIN=0

# Model id used when the UI has not selected one. Empty means the first
# discovered model. Example: LiquidAI/LFM3-Omni-2B-GGUF:Q8_0
DEFAULT_MODEL=

# --- Optional single-model override ----------------------------------------
# When MODEL is set, the cache scan is skipped and one preset is generated
# from this file. MMPROJ is optional; a sibling mmproj*.gguf is used when
# present. Leave both unset to use router mode.
#MODEL=$HOME/SoyMH/GitHub/lfm3-voice-local/models/LFM3-Omni-2B-Q4_K_M.gguf
#MMPROJ=$HOME/SoyMH/GitHub/lfm3-voice-local/models/mmproj-LFM3-Omni-2B-Q8_0.gguf

# --- Voice (push-to-talk over /v1/realtime) ---------------------------------
# Empty MIC_DEVICE uses the default PipeWire source.
MIC_DEVICE=

# Capture rate. The server-reported rate wins when it differs.
MIC_RATE=16000

# Empty SPEAKER_DEVICE uses the default PipeWire sink.
SPEAKER_DEVICE=

# Playback rate. The server-reported rate wins when it differs.
VOICE_OUTPUT_RATE=24000

# System prompt sent with the realtime session.
VOICE_INSTRUCTIONS="Respond with interleaved text and audio."

# Playback volume, 0.0 to 1.0.
VOICE_VOLUME=0.2

# --- llama-server ----------------------------------------------------------
# llama-server binary. Falls back to `llama-server` on PATH when missing.
LLAMA_SERVER=/home/soymh/SoyMH/llama.cpp/build/bin/llama-server

# Localhost port. The bridge only ever binds 127.0.0.1.
PORT=8011

# Context size passed to every router model instance.
CTX=16384

# Stop llama-server after this many idle seconds. 0 keeps it running.
IDLE_TIMEOUT=300

# Seconds to wait for /health while the router starts.
LOAD_TIMEOUT=240

# Cursor-compatible MCP server definitions (stdio only).
MCP_CONFIG=$HOME/.config/lfm3-assistant/mcp.json

# --- Local tools -----------------------------------------------------------
# DigUp CLI used by the digup_search tool (read-only).
DIGUP_BIN=$HOME/.local/bin/digup-linux

# Default and maximum number of digup_search results.
DIGUP_LIMIT=8

# Allow server/MCP tools that declare write permission. Keep 0 for read-only.
ALLOW_WRITE_TOOLS=0

# --- Attachments (images, video, audio) ------------------------------------
# Directory llama-server may read media from. Passed as --media-path, and
# file:// attachment URLs resolve inside it. Every attachment path must be an
# absolute file below this directory. $HOME covers most desktop cases.
MEDIA_PATH=$HOME

# Reject attachments larger than this many MB. Images are base64 encoded into
# the request; video and audio are referenced by file:// path and need a
# multimodal model plus ffmpeg support in llama.cpp.
MEDIA_MAX_MB=20

# llama-server stdout/stderr log file.
LLAMA_LOG=$HOME/.local/state/lfm3-assistant/llama-server.log

# Extra llama-server arguments, e.g. --n-gpu-layers 99
EXTRA_ARGS=

# Speak typed answers through POST /tts.
SPEAK_TEXT=1
# female or male for LFM3-Audio / LFM3-Omni.
TTS_VOICE=female
TTS_MAX_CHARS=1200
